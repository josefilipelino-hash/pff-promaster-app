# Momento Studio — variáveis de ambiente de DESENVOLVIMENTO.
# Copiar para `.env` (ignorado pelo Git). Nunca colocar credenciais reais neste ficheiro.

# Nível de registo do núcleo Rust (tracing): error | warn | info | debug | trace
RUST_LOG=info

# Pasta com fotografias de teste reais (fora do repositório). Usada por testes manuais
# e pelos testes de compatibilidade RAW da Fase 2. Deixar vazio se não existir.
MOMENTO_SAMPLES_DIR=

# Pasta onde os modelos de IA são descarregados (Fase 3). Por omissão usa a pasta de
# suporte da aplicação do sistema operativo.
MOMENTO_MODELS_DIR=
