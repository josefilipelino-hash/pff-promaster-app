{
  "name": "momento-studio",
  "private": true,
  "version": "0.12.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @momento/desktop tauri dev",
    "build": "pnpm --filter @momento/desktop tauri build",
    "web:dev": "pnpm --filter @momento/desktop dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:rust": "cargo test --workspace",
    "check": "pnpm typecheck && pnpm test && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  }
}
