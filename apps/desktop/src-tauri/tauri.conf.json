{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PFF ProMaster",
  "version": "1.1.3",
  "identifier": "pt.pffpromaster.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PFF ProMaster",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' momento: http://momento.localhost asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "Photography",
    "resources": {
      "../../../models/": "models/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 180
        }
      },
      "signingIdentity": "-"
    },
    "publisher": "PFF ProMaster (uso pessoal)",
    "copyright": "© 2026 PFF ProMaster — uso pessoal",
    "shortDescription": "Gestão, seleção, edição e entrega de fotografia de casamentos",
    "longDescription": "Aplicação local para fotógrafos de casamentos e eventos: importação segura de cartões, seleção assistida, edição RAW não destrutiva, exportação, galeria do cliente e álbum para o laboratório. Funciona sem internet; nada é enviado sem pedido."
  }
}
